{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--project-ref", "qafixtureref"],
      "env": { "SUPABASE_ACCESS_TOKEN": "sbp_FAKE_QA_FIXTURE_TOKEN_NOT_REAL" }
    },
    "supabase-readonly": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--read-only"],
      "env": { "SUPABASE_ACCESS_TOKEN": "sbp_FAKE_QA_FIXTURE_TOKEN_NOT_REAL" }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ghp_FAKE_QA_FIXTURE_TOKEN" }
    },
    "local-tools": { "command": "node", "args": ["./tools/server.js"] },
    "internal": { "type": "http", "url": "${INTERNAL_MCP_URL}/mcp" },
    "sentry-old": { "command": "npx", "args": ["-y", "@sentry/mcp-server"], "disabled": true },
    "mongodb": { "command": "npx", "args": ["-y", "mongodb-mcp-server", "--connectionString", "mongodb://qa:FAKE@db.example.invalid/orders"] },
    "reports-two": { "type": "http", "url": "${REPORTS_TWO_URL}/mcp" },
    "postgres-prod": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://qa:FAKE_PASSWORD@db.example.invalid/orders"]
    }
  }
}
